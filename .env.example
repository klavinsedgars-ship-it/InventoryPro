# --- Database (Neon serverless PostgreSQL) ---
# Any one of these will be used (DATABASE_URL takes priority):
#   DATABASE_URL, NEON_DATABASE_URL, POSTGRES_URL
# Vercel's official Neon integration creates NEON_DATABASE_URL, so it
# works out of the box. For local dev, set DATABASE_URL.
# NOTE: prefer setting DATABASE_URL explicitly and deleting stale fallbacks —
# a leftover NEON_DATABASE_URL pointing at a dead database is a silent outage.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# One-shot interlock for /api/__schema-reset?confirm=RESET, which DROPS the
# public schema and provisions the current one (then seeds admin/categories/
# tiers). Set to true, run the endpoint once, then REMOVE this var.
# ALLOW_SCHEMA_RESET=true

# --- TME API ---
# v2 (OAuth/REST, TME's "Current Version"). The EXISTING v1 token/secret
# authenticate against v2 unchanged — verified via /api/__tme-v2-check.
# Set to "v2" to move the sync onto it: 4 req/sec vs v1's 2, plus
# product_status so items TME will not sell us never reach a listing, and a
# per-quantity shippability pre-check before publishing.
# TME_API_VERSION=v2
# Price basis — never rely on the account default (TME returns the customer
# configuration's currency; a PLN figure consumed as EUR corrupts every margin).
# TME_CURRENCY=EUR
# TME_COUNTRY=LV
# Real per-second limits (TME support, 2026-08). v1: 2/sec for the price and
# stock endpoints, 10/sec for the rest. v2: 4/sec for /products/data.
# TME_RPS_PRICES=2
# TME_RPS_DEFAULT=10
# TME_V2_RPS_DATA=4

# --- API daily call limits (enforced from the DB counter, reset at midnight) ---
# TME: the historical 10000/day figure is an unverified assumption — confirm
# your real quota with TME (developers.tme.eu / your account manager) and set
# it here. 0 disables the cap.
# TME_DAILY_LIMIT=10000
# eBay: default 2,000,000 (approved-application cap for the Sell APIs). The
# listing-ramp stops at EBAY_DAILY_CALL_SOFT_CAP_PCT (default 80%) of this.
# EBAY_DAILY_LIMIT=2000000

# --- Session ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- TME supplier API ---
TME_TOKEN=
TME_APPLICATION_SECRET=
TME_CUSTOMER_NUMBER=
TME_CONTACT_NUMBER=

# --- eBay OAuth 2.0 (Trading + REST APIs use the same token) ---
EBAY_OAUTH_CLIENT_ID=
EBAY_OAUTH_CLIENT_SECRET=
EBAY_OAUTH_REFRESH_TOKEN=
# Optional: set to "production" or "sandbox"
EBAY_ENVIRONMENT=production

# --- eBay marketplace / listing config ---
# Site ID: 3=UK (GBP), 77=DE (EUR). Unset defaults to UK for back-compat.
EBAY_MARKETPLACE_SITE_ID=77
EBAY_LISTING_CURRENCY=EUR
# Where the goods ship from (unchanged for DE since seller is in Latvia)
EBAY_LISTING_COUNTRY=LV
EBAY_LISTING_LOCATION=Riga, Latvia

# Business-policy IDs for the active marketplace. Create via
# POST /api/__bootstrap-de-policies, then paste the returned IDs here.
EBAY_PAYMENT_PROFILE_ID=
EBAY_RETURN_PROFILE_ID=
# 5 weight bands matching Latvijas Pasts Sīkpaka tariff brackets
EBAY_SHIPPING_POLICY_0_20GR=
EBAY_SHIPPING_POLICY_21_100GR=
EBAY_SHIPPING_POLICY_101_500GR=
EBAY_SHIPPING_POLICY_501_1000GR=
EBAY_SHIPPING_POLICY_1001_2000GR=

# --- Runtime ---
NODE_ENV=production
# DO NOT set BYPASS_AUTH=true in production; the server will refuse to start.
# BYPASS_AUTH=true
