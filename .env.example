# --- Database (Neon serverless PostgreSQL) ---
# Any one of these will be used (DATABASE_URL takes priority):
#   DATABASE_URL, NEON_DATABASE_URL, POSTGRES_URL
# Vercel's official Neon integration creates NEON_DATABASE_URL, so it
# works out of the box. For local dev, set DATABASE_URL.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# --- Session ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- TME supplier API ---
TME_TOKEN=
TME_APPLICATION_SECRET=
TME_CUSTOMER_NUMBER=
TME_CONTACT_NUMBER=

# --- eBay OAuth 2.0 (Trading + REST APIs use the same token) ---
EBAY_OAUTH_CLIENT_ID=
EBAY_OAUTH_CLIENT_SECRET=
EBAY_OAUTH_REFRESH_TOKEN=
# Optional: set to "production" or "sandbox"
EBAY_ENVIRONMENT=production

# --- Runtime ---
NODE_ENV=production
# DO NOT set BYPASS_AUTH=true in production; the server will refuse to start.
# BYPASS_AUTH=true
