{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist/public",
  "framework": null,
  "functions": {
    "api/proxy.js": { "maxDuration": 300 }
  },
  "rewrites": [
    { "source": "/api/(.+)", "destination": "/api/proxy?_origPath=$1" },
    { "source": "/((?!api/|__build).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/daily-sync", "schedule": "0 * * * *" },
    { "path": "/api/cron/list-ramp", "schedule": "30 * * * *" },
    { "path": "/api/cron/auto-messages", "schedule": "15 * * * *" },
    { "path": "/api/cron/orders", "schedule": "5,25,45 * * * *" },
    { "path": "/api/cron/maintenance", "schedule": "50 3 * * *" }
  ]
}
