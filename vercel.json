{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist/public",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.+)", "destination": "/api/proxy?_origPath=$1" },
    { "source": "/((?!api/|__build).*)", "destination": "/index.html" }
  ]
}
